# Copy to .secrets/tooling.env and fill in your values. Never commit it.
# A repo-root .env is still read as a fallback, second, so an existing .env
# keeps working — but .secrets/ is preferred because Nx auto-loads a workspace
# .env into every task it runs, putting tooling tokens in every app process.
# See docs/reference/configuration.md#environment-variables for full reference.

# ── Jira (required for all Jira operations) ──────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_USER_EMAIL=dev@example.com
JIRA_API_TOKEN=ATATT3x...
JIRA_PROJECT_KEY=PROJ

# Backlog placement (Scrum boards only — omit if using Kanban or no board)
# JIRA_BOARD_ID=42

# Classic-project field overrides (omit for team-managed projects)
# JIRA_EPIC_LINK_FIELD=customfield_10014
# JIRA_EPIC_NAME_FIELD=customfield_10011

# ── Bitbucket (required for PR creation and VCS links in Jira) ───────────────
# Two credential types are supported. Set ONE.
#
# Basic — an Atlassian API token with the Bitbucket scopes ticked, plus your
# account email. This is the default and needs no other change.
BITBUCKET_USERNAME=jsmith
BITBUCKET_APP_PASSWORD=ATB...

# Bearer — a repository, project or workspace access token. Optional. It
# REPLACES the two lines above rather than supplementing them (an access token
# has no username), and wins if both are set. Leave commented out to stay on
# Basic; nothing else changes.
# BITBUCKET_ACCESS_TOKEN=ATCTT...

# Override auto-detected remote URL (rarely needed)
# BITBUCKET_REPO_URL=https://bitbucket.org/yourorg/yourrepo

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub uses the gh CLI. Run `gh auth login` once.
# Set GH_TOKEN only in CI where interactive login is unavailable.
# GH_TOKEN=ghp_...

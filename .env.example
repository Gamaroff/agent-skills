# Copy to .env and fill in your values. Never commit .env.
# See docs/reference/configuration.md#environment-variables for full reference.

# ── Jira (required for all Jira operations) ──────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_USER_EMAIL=dev@example.com
JIRA_API_TOKEN=ATATT3x...
JIRA_PROJECT_KEY=PROJ

# Backlog placement (Scrum boards only — omit if using Kanban or no board)
# JIRA_BOARD_ID=42

# Classic-project field overrides (omit for team-managed projects)
# JIRA_EPIC_LINK_FIELD=customfield_10014
# JIRA_EPIC_NAME_FIELD=customfield_10011

# ── Bitbucket (required for PR creation and VCS links in Jira) ───────────────
BITBUCKET_USERNAME=jsmith
BITBUCKET_APP_PASSWORD=ATB...

# Override auto-detected remote URL (rarely needed)
# BITBUCKET_REPO_URL=https://bitbucket.org/yourorg/yourrepo

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub uses the gh CLI. Run `gh auth login` once.
# Set GH_TOKEN only in CI where interactive login is unavailable.
# GH_TOKEN=ghp_...

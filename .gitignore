.DS_Store
firebase-debug.log
*.log
# …but eval replay fixtures include committed *.log expected-output files (test
# data the runner copies into the sandbox), not build noise — keep tracking them.
!evals/**/replay/**/*.log
node_modules/
__pycache__/
*.pyc
*.pyo

# Skill packages — build artifacts, regenerate via package_skill.py
skills/*/*.zip
*.zip

# Unpacked skill output — never check in (shadow dirs created by unzip inside skill source dir)
skills/*/*/SKILL.md
CLAUDE.md

# Claude Code session state — pipeline locks and other runtime artifacts
.claude/
.windsurf/
.agents/state/

# Subagent summary artifacts — runtime-local, see shared/resources/subagent-summary-artifact.md
.summaries/

# Secrets — defensive, none should ever be tracked
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials
credentials.*
secrets.json
secrets.yaml
secrets.yml
*.sqlite
*.sqlite3

# Antigravity CLI local state
.antigravitycli/

# Obsidian local workspace state (pane layout churns per session)
.obsidian/workspace*.json
.obsidian/

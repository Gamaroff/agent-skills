.DS_Store
firebase-debug.log
*.log
node_modules/
node_modules
__pycache__/
*.pyc
*.pyo

# Skill packages — build artifacts, regenerate via package_skill.py
skills/*/*.zip
*.zip

# Unpacked skill output — never check in (shadow dirs created by unzip inside skill source dir)
skills/*/*/SKILL.md
CLAUDE.md

# Claude Code session state — pipeline locks and other runtime artifacts
.claude/
.windsurf/
.agents/state/
.agents/skills

# Subagent summary artifacts — runtime-local, see shared/resources/subagent-summary-artifact.md
.summaries/

# Secrets — defensive, none should ever be tracked
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials
credentials.*
secrets.json
secrets.yaml
secrets.yml
*.sqlite
*.sqlite3

# Antigravity CLI local state
.antigravitycli/

# Obsidian local workspace state (pane layout churns per session)
.obsidian/workspace*.json
.obsidian/

# ── Eval replay fixtures (committed test data) ────────────────────────────────
# The eval runner copies each scenario's replay/ tree verbatim into a sandbox.
# Those fixtures intentionally include paths matched by the rules above (*.log,
# .claude/, …), so re-include the entire replay subtree — a fresh clone (CI) must
# have byte-identical fixtures to a local checkout. MUST stay at the END of this
# file: a gitignore negation only overrides rules that appear before it, and the
# directory negation must precede the file negation so git descends into
# otherwise-ignored fixture dirs (e.g. replay/.claude/).
!evals/**/replay/
!evals/**/replay/**/
!evals/**/replay/**

.DS_Store
firebase-debug.log
*.log
node_modules/
__pycache__/
*.pyc
*.pyo

# Skill packages — build artifacts, regenerate via package_skill.py
skills/*/*.zip
*.zip

# Unpacked skill output — never check in (shadow dirs created by unzip inside skill source dir)
skills/*/*/SKILL.md
CLAUDE.md

# Claude Code session state — pipeline locks and other runtime artifacts
.claude/
.windsurf/
.agents/state/

# Subagent summary artifacts — runtime-local, see shared/resources/subagent-summary-artifact.md
.summaries/

# Secrets — defensive, none should ever be tracked
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials
credentials.*
secrets.json
secrets.yaml
secrets.yml
*.sqlite
*.sqlite3

[
  {
    "id": "garbage-yaml",
    "sink": "path",
    "direction": "hostile",
    "input": "garbage.yaml",
    "why": "An unparseable agent answer must not produce a record the next run would carry from.",
    "correct": "prints 'full (result-unparseable)', exits 0, writes no out.ac.json",
    "expected": {
      "exit": 0,
      "stdout": "full (result-unparseable)\n",
      "absent": [
        "out.ac.json"
      ]
    },
    "fixture": {
      "files": {
        "garbage.yaml": "::: not yaml [\n\t- {\n",
        "scope.json": "{\"mode\":\"full\",\"reason\":\"no-prior-record\",\"head\":\"0123456789abcdef0123456789abcdef01234567\",\"criteria\":[{\"id\":\"SC-1\",\"text\":\"SC-1: the engine scopes a re-run\",\"text_hash\":\"0000\"}],\"rejudge\":[{\"id\":\"SC-1\",\"reason\":\"full\"}],\"carry\":[],\"dirty\":[],\"document\":\"doc.md\"}",
        ".git/HEAD": "ref: refs/heads/main\n",
        ".git/config": "[core]\n\trepositoryformatversion = 0\n\tbare = false\n",
        ".git/objects/info/.keep": "",
        ".git/refs/heads/.keep": "",
        ".git/refs/tags/.keep": ""
      }
    }
  },

        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.example.md",
        "\\| \\d{4}-\\d{2}-\\d{2} \\|\\s*[\\d.]+\\s*\\| DoD passed[^|]*\\| finalise \\|"

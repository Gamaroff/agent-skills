      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.gate.5.example.yml",
        "gate: CONCERNS"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.gate.6.example.yml",
        "gate: PASS"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.gate.6.example.yml",
        "half-cycle: gate-the-last-fix"

{
  "name": "develop-story-step-05-reentry-after-loop-limit-grant",
  "skill": "develop-story",
  "description": "Phase 0b re-entry after a loop-limit halt (task.123 / obs #95): the halt snapshot records halt_reason loop-limit at 5 cycles; the operator then ran a standalone qa-story that wrote gate.6 and qa.6 but no QA Cycle entry. Re-invocation reconstructs the count from disk (6), back-fills cycle 6 as run outside the loop, offers \"Resume at 5a with {k} more cycles\", writes extra_cycles_granted: 2 to the lock, and resumes at 5a as cycle 7 under QA_MAX_CYCLES 7. Fixture records the resume detector, then qa-story (cycle 7) → qa-fix → qa-story (cycle 8, PASS) → review-pr.",
  "prompt": "Re-invoke /develop-story for story.5.1.example after a QA loop-limit halt. A standalone /qa-story was run by hand between the halt and this re-invocation. Accept the recommended grant.",
  "assertions": [
    {
      "fn": "fileExists",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.gate.6.example.yml"
      ]
    },
    {
      "fn": "fileExists",
      "args": [
        "$SANDBOX/.claude/state/develop-pipeline.lock"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/.claude/state/develop-pipeline.lock",
        "\"extra_cycles_granted\": 2"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/.claude/state/develop-pipeline.lock",
        "\"current_step\": 5"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/.claude/state/develop-pipeline.lock",
        "\"qa_phase\": \"5c\""
      ]
    },
    {
      "fn": "fileDoesNotMatch",
      "args": [
        "$SANDBOX/.claude/state/develop-pipeline.lock",
        "cycles_outside_loop"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.implementation.1.example.md",
        "### QA Cycle 6"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.implementation.1.example.md",
        "\\*\\*Origin\\*\\*: run outside the loop \\(operator\\)"
      ]
    },
    {
      "fn": "fileMatches",
      "args": [
        "$SANDBOX/docs/prd/domain/feature/epics/epic.5.example/stories/story.5.1.example/story.5.1.implementation.1.example.md",
        "### QA Cycle 8"
      ]
    },
    {
      "fn": "resumeRehydrated",
      "args": [
        "$SANDBOX/.eval/pipeline-events.json",
        {
          "expectedStep": "qa-story",
          "expectedIter": 2
        }
      ]
    },
    {
      "fn": "pipelineStepsRan",
      "args": [
        "$SANDBOX/.eval/pipeline-events.json",
        [
          "resume-detector",
          "qa-story",
          "qa-fix",
          "qa-story",
          "review-pr"
        ]
      ]
    },
    {
      "fn": "loopBoundedAt",
      "args": [
        "$SANDBOX/.eval/pipeline-events.json",
        "qa-story",
        2
      ]
    }
  ]
}

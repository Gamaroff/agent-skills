{
  "name": "04-planted-bug",
  "skill": "review-pr",
  "setup": "../../setup.mjs",
  "description": "task.901 says 18 and over is an adult; the diff implements age > 18 and tests only 17 and 30, while the trail claims a boundary test. The verdict must not be APPROVE, and a CR- finding must cite src/age.js.",
  "prompt": "/review-pr 901",
  "cliArgs": [
    "--allowedTools",
    "Bash",
    "Read",
    "Grep",
    "Glob",
    "Write",
    "Edit",
    "Agent",
    "Skill"
  ],
  "fixture": {
    "variant": "planted-bug"
  },
  "live": {
    "minPass": 4
  },
  "assertions": [
    {
      "fn": "fileExists",
      "args": [

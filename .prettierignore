# Prettier covers JavaScript only. Markdown, YAML and JSON are excluded
# deliberately — this repo's documents are hand-wrapped (tables, ASCII diagrams,
# deliberate line breaks in prose) and a reformat would churn hundreds of files
# while making them harder to read, not easier.
*.md
*.yml
*.yaml
*.json

node_modules/
.git/

# Generated by `npm run bundle` — copies of shared/resources/*. Formatting these
# independently of their source is how the copies drift from it.
skills/*/references/

# Build artifacts.
skills/*/*.zip

# Recorded fixtures must stay byte-exact or replay stops matching.
evals/**/replay/
